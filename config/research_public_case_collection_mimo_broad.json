{
  "source": {
    "provider": "zh_wikisource_mediawiki",
    "api_url": "https://zh.wikisource.org/w/api.php",
    "user_agent": "DelayDisputeCopilotResearch/1.0 (academic public-document collection)",
    "search_limit_per_call": 250,
    "max_total_candidates": 30000,
    "sleep_between_requests_sec": 1.0,
    "queries": [
      "工期延误",
      "延误工期",
      "工期顺延",
      "逾期竣工",
      "逾期交工",
      "延期竣工",
      "延期交付 工程",
      "逾期交付 工程",
      "停工 窝工",
      "工期 违约金",
      "工期 索赔",
      "工程延期",
      "施工进度 延误",
      "开工令 工期",
      "竣工验收 逾期",
      "关键线路 工期",
      "施工合同 工期",
      "承包人 工期延误",
      "发包人 工期延误",
      "实际施工人 工期延误",
      "建设工程 工期",
      "建设工程 逾期",
      "建设工程 停工",
      "建设工程 窝工",
      "建设工程 违约金",
      "工程款 工期延误",
      "质量问题 工期延误",
      "签证 工期",
      "监理 工期延误",
      "鉴定 工期延误"
    ]
  },
  "quality": {
    "min_text_chars": 2500,
    "min_search_hit_size": 2500,
    "require_judgment_title": true,
    "drop_procedural_only": true,
    "local_candidate_threshold": 0.5,
    "mimo_accept_threshold": 0.72
  },
  "mimo": {
    "base_url_env": "MIMO_OPENAI_BASE_URL",
    "api_key_env": "MIMO_API_KEY",
    "model_name": "mimo-v2.5-pro",
    "temperature": 0.0,
    "max_tokens": 2000,
    "timeout_sec": 120,
    "retries": 1,
    "workers": 8,
    "max_chars_for_screening": 4000,
    "enabled": true
  },
  "paths": {
    "output_root": "data/external_mimo_candidates"
  }
}
